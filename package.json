{
  "name": "water-utility-data-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "start": "concurrently -k -n api,web \"npm run start -w backend\" \"npm run start -w frontend\"",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p backend/tsconfig.json && tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "format": "prettier --write .",
    "test": "tsx --test backend/tests/unit/unit.test.ts",
    "test:integration": "tsx backend/scripts/integration-test.ts",
    "test:security": "tsx backend/scripts/integration-test.ts --security",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "tsx backend/scripts/database.ts migrate",
    "db:status": "tsx backend/scripts/database.ts status",
    "db:seed": "tsx backend/scripts/database.ts seed",
    "db:local": "tsx backend/scripts/local-postgres.ts",
    "setup:local": "tsx backend/scripts/setup-local.ts",
    "demo:verify": "tsx scripts/demo/walkthrough.ts",
    "dev:local": "tsx scripts/dev/local-preview.ts",
    "demo:local": "tsx scripts/dev/local-preview.ts demo",
    "cebu:local": "tsx backend/scripts/cebu-maintenance.ts",
    "demo:samples": "tsx backend/scripts/demo-samples.ts",
    "check:architecture": "tsx scripts/check-architecture.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prisma": "6.19.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "prisma": {
    "schema": "backend/prisma/schema.prisma"
  }
}
